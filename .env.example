# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Database Configuration (Placeholder for future development)
# DATABASE_URL="postgresql://user:password@localhost:5432/banksampah"

# Authentication (Placeholder for future development)
# NEXTAUTH_SECRET="generate-a-strong-secret-key-here"
# NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Integrasi Telegram Bot (opsional)
# ─────────────────────────────────────────────────────────────────────────────
# Semua integrasi Telegram bersifat OPSIONAL. Bila variabel di bawah tidak diisi,
# aplikasi tetap berjalan penuh: notifikasi lonceng, transaksi, penarikan, AI,
# dan seluruh fitur lain tidak berubah sama sekali.
#
# Cara mendapatkannya:
#   1. Buka Telegram, cari "@BotFather", kirim /newbot, ikuti petunjuknya.
#   2. BotFather memberi satu token seperti 123456789:AAExxxxxxxxxxxxxxxxxxxxxxx
#   3. Salin token itu ke TELEGRAM_BOT_TOKEN di file .env.local Anda.
#
# Token adalah kredensial. JANGAN pernah menaruhnya di kode frontend, jangan
# menyimpannya di repository, dan jangan membagikannya.
TELEGRAM_BOT_TOKEN=""

# Username bot TANPA tanda "@" (contoh: BankSampahDigitalBot).
# Dipakai untuk menyusun tautan aktivasi https://t.me/<username>?start=<kode>
TELEGRAM_BOT_USERNAME=""

# Secret acak untuk memverifikasi webhook Telegram. Minimal 16 karakter.
# Telegram mengirimnya pada header "X-Telegram-Bot-Api-Secret-Token" di setiap
# request, dan route /api/telegram/webhook akan menolaknya bila tidak cocok.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""

# URL publik yang bisa diakses internet, dipakai oleh skrip setup untuk
# mendaftarkan webhook ke Telegram (opsional bila memakai reverse proxy sendiri).
TELEGRAM_WEBHOOK_URL=""

# Catatan: NEXTAUTH_SECRET juga dipakai sebagai kunci enkripsi payload
# kredensial pada kode aktivasi. Pastikan NEXTAUTH_SECRET sudah diset di .env.local.

# ─────────────────────────────────────────────────────────────────────────────
# AI Configuration Center (Admin) & Enkripsi
# ─────────────────────────────────────────────────────────────────────────────
# Kunci enkripsi server untuk menyimpan API Key AI di database (AES-256-GCM).
# Jika tidak diset, sistem akan fallback menggunakan NEXTAUTH_SECRET.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_CONFIG_ENCRYPTION_KEY=""

# Bootstrap AI Provider (opsional, sebagai fallback sebelum konfigurasi disimpan di database)
GROQ_API_KEY=""